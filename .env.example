# The domain /worth is served from: share cards and link previews resolve against it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The unfair API host (creators and who has a published page). Without it the board
# starts empty and nobody is marked as having a page.
UNFAIR_API_BASE_URL=

# twitterapi.io key: how /worth reads an X account's followers and posts. Without it
# accounts off unfair.so are priced on followers alone.
X_SCAN_KEY=

# Where the board keeps every account it has read. Default: .data in dev,
# .next/cache/worth in production; a deploy that starts empty refills it itself.
# WORTH_DATA_DIR=
