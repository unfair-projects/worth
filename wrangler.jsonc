{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worth",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "worth" }],
  "routes": [{ "pattern": "myaccworth.com", "custom_domain": true }],
  "kv_namespaces": [
    {
      "binding": "WORTH_KV",
      // create it with `npx wrangler kv namespace create WORTH_KV` and paste the id here
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://myaccworth.com"
  },
  "observability": { "enabled": true }
  // secrets, set with `npx wrangler secret put <NAME>` (the app works without them):
  //   X_SCAN_KEY          twitterapi.io key
  //   UNFAIR_API_BASE_URL the unfair API host
}
